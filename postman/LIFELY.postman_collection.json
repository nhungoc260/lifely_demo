      "name": "1. System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('database UP', () => pm.expect(pm.response.json().data.database.status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected without token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/donors/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public stats",
          "request": {
