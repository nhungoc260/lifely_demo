      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "donorToken",
      "value": ""
    },
    {
      "key": "requesterToken",
      "value": ""
    },
    {
      "key": "hospitalToken",
      "value": ""
