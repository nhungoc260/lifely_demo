            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Eve\",\n  \"email\": \"eve@x.test\",\n  \"phone\": \"0901234567\",\n  \"password\": \"Passw0rdOK\",\n  \"confirmPassword\": \"Passw0rdOK\",\n  \"role\": \"ADMIN\"\n}"
