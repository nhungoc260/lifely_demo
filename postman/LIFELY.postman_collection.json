    {
      "name": "5. Request lifecycle",
      "item": [
        {
          "name": "Create request (requester → PENDING_VERIFICATION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"O+\",\n  \"unitsRequired\": 2,\n  \"hospitalName\": \"Postman Test Clinic\",\n  \"city\": \"TP. Hồ Chí Minh\",\n  \"district\": \"Quận 1\",\n  \"latitude\": 10.7769,\n  \"longitude\": 106.7009,\n  \"urgency\": \"URGENT\",\n  \"deadline\": \"2099-01-01T00:00:00Z\",\n  \"contactPhone\": \"0901234567\",\n  \"description\": \"Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deadline in 2099 is rejected (max 7 days)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create request with invalid input → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodType\": \"X+\",\n  \"unitsRequired\": 99,\n  \"hospitalName\": \"\",\n  \"city\": \"\",\n  \"latitude\": 10,\n  \"longitude\": 106,\n  \"urgency\": \"URGENT\",\n  \"deadline\": \"2020-01-01T00:00:00Z\",\n  \"contactPhone\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('has field errors', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Requester dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/requests/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: pending requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/requests?status=PENDING_VERIFICATION"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const it = pm.response.json().data.items[0];",
                  "if (it) pm.collectionVariables.set('requestId', it.request.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: verify request (starts matching)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/requests/{{requestId}}/verify"
          }
        },
        {
          "name": "Admin: audit log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/audit-logs?action=REQUEST_VERIFIED"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
