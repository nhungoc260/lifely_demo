# Sao chép file này thành .env (KHÔNG commit .env).
# Chỉ dùng giá trị dưới đây cho môi trường phát triển trên máy cá nhân.

# ---- Backend (đọc từ ../.env khi chạy trong thư mục backend/) ----
DB_URL=jdbc:postgresql://localhost:5432/lifely
DB_USERNAME=lifely
DB_PASSWORD=lifely_dev_password
# Tối thiểu 32 ký tự. Tạo chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars-long
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Môi trường demo: dời deadline của dữ liệu seed mỗi lần khởi động để kịch bản demo luôn còn hiệu lực.
DEMO_ENVIRONMENT=true
DEMO_REFRESH_DEADLINES=true
# Prototype chưa có email/SMS: true = in link đặt lại mật khẩu vào log máy chủ (CHỈ dev, đặt false ở production)
LOG_RESET_LINK=true
UPLOAD_DIR=./uploads

# ---- Frontend (đặt trong frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Liên hệ nhân viên hỗ trợ (hiển thị công khai: chỉ dùng số của người đã đồng ý) ----
NEXT_PUBLIC_SUPPORT_NAME=Như Ngọc
NEXT_PUBLIC_SUPPORT_PHONE=0765099748
